# School ERP Frontend - Environment Variables Template
# Copy this file to .env or .env.local for local development.

# Application Environment ('development' | 'test' | 'production')
VITE_APP_ENV=development

# Application Title & Metadata
VITE_APP_TITLE="School ERP"

# Backend API Base URL (Do not hardcode production credentials or secret tokens here)
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000

# Feature Flags (if applicable)
VITE_ENABLE_DEVTOOLS=true
